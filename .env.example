# Copy to .env and replace every value before deploying.
# 部署形态：裸 IP + 9961 端口直连，客户端用 ws://<服务器IP>:9961/ws/{game,bot}。
# 这条链路没有 TLS，Token 在公网是明文，务必配合防火墙 IP 白名单使用。
THCHAOS_HOST=0.0.0.0
THCHAOS_PORT=8765
THCHAOS_ALLOW_DEV_TOKENS=0
THCHAOS_GAME_TOKENS={"replace-with-long-game-token":"main"}
THCHAOS_BOT_TOKENS={"replace-with-long-bot-token":"main"}
# Optional; enables GET /rooms/{room}/state with X-Admin-Token.
THCHAOS_ADMIN_TOKEN=replace-with-another-long-token
# 将来接域名 + TLS 时才需要（见 README 附录 C）：
# THCHAOS_DOMAIN=vote.example.com
# 国内服务器构建时连不上 Docker Hub / PyPI 才需要（只影响 docker compose build）：
# DOCKER_REGISTRY=docker.1ms.run
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
